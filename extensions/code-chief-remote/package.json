{
  "name": "code-chief-remote",
  "displayName": "Code Chief Remote",
  "description": "Expose VS Code over local network with QR sign-in for Code Chief Mobile.",
  "version": "0.0.1",
  "publisher": "codechief",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeChiefRemote",
          "title": "Code Chief",
          "icon": "./media/code-chief.svg"
        }
      ]
    },
    "views": {
      "codeChiefRemote": [
        {
          "id": "codeChiefRemote.qrView",
          "name": "QR Code",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "code-chief-remote.showQr",
        "title": "Code Chief Remote: Show QR"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Code Chief Remote",
      "properties": {
        "codeChiefRemote.port": {
          "type": "number",
          "default": 3000,
          "description": "Port to run the Code Chief Remote server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run compile"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.19.0",
    "@types/ws": "^8.5.8",
    "typescript": "^5.2.2",
    "@types/vscode": "^1.83.0",
    "@types/qrcode": "^1.5.5"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0",
    "qrcode": "^1.5.1"
  }
}
